# Copy this file to .env and fill in your own values. .env is ignored by git.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=roar
PORT=8787

# Free Gemini key from aistudio.google.com (starts with AIza). Server only.
ROAR_GEMINI_KEY=your-gemini-key
